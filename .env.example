DATABASE_URL=postgresql://hanyuflow:local-change-me@localhost:5432/hanyuflow
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Optional. All external capabilities remain explicitly unconfigured without these.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=20
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Specialized pronunciation, email, push and billing adapters are not implemented.
# Seed accounts require deliberate local opt-in; never enable this in production.
SEED_DEV_USERS=false
